# Directory to search. Required at boot. Realpath'd once. ~ is expanded.
WEB_GREP_ROOT=

# Bind address only (127.0.0.1, ::1, 0.0.0.0, ::). Never used as a Host name.
WEB_GREP_HOST=127.0.0.1

# Listen port.
WEB_GREP_PORT=8787

# Comma-separated DNS names / IPs in the address bar (e.g. 192.168.1.10,grep.lab).
# Required when bind is non-loopback. Never 0.0.0.0.
# WEB_GREP_PUBLIC_HOST=

# If set, required as Authorization: Bearer or X-Web-Grep-Token.
# Required when bind is non-loopback.
# WEB_GREP_TOKEN=

# Absolute override of the rg binary.
# Detection: WEB_GREP_RG → PATH → @vscode/ripgrep (optional native, no postinstall
# download) → literal JS walker (no gitignore, no regex).
# WEB_GREP_RG=

# Soft cap on hits (truncated=true). 0 = unlimited.
WEB_GREP_MAX_RESULTS=20000

# 0 = no hard clamp.
WEB_GREP_MAX_RESULTS_HARD=0

# Search wall-clock timeout in milliseconds. 0 = no timeout (good for large logs).
WEB_GREP_TIMEOUT_MS=0

# Unused: file size is not capped (search or preview).
# WEB_GREP_PREVIEW_BYTES=0

# before + line + after max window.
WEB_GREP_PREVIEW_LINES=201

# Passed to rg --threads. 0 lets rg choose.
WEB_GREP_THREADS=0

# Max simultaneous searches.
WEB_GREP_MAX_CONCURRENT=8

# Search gzip/xz/bzip2/zstd (rg --search-zip).
WEB_GREP_SEARCH_ZIP=true

# Follow directory symlinks. File symlinks that escape the root are still dropped.
WEB_GREP_FOLLOW_SYMLINKS=true

# Skip gitignore / .ignore / .rgignore. Default true so log trees are fully searchable.
WEB_GREP_NO_IGNORE=true

# Disable the secret/junk denylist. Logs a warning at boot. Dangerous.
WEB_GREP_ALLOW_SECRETS=false

# debug | info | warn | error
WEB_GREP_LOG_LEVEL=info
