{
  "name": "web-grep",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "predev": "pnpm --filter @web-grep/shared build",
    "dev": "bash scripts/dev.sh",
    "dev:shared": "pnpm --filter @web-grep/shared dev",
    "dev:server": "WEB_GREP_DEV=1 go run -C apps/server ./cmd/web-grep",
    "dev:web": "pnpm --filter @web-grep/web dev",
    "build": "tsc -b --force && pnpm --filter @web-grep/web build && mkdir -p dist && go build -C apps/server -o ../../dist/web-grep ./cmd/web-grep",
    "start": "./dist/web-grep",
    "typecheck": "tsc -b",
    "test": "vitest run && go test -C apps/server ./...",
    "lint": "oxlint --type-aware --type-check",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2",
    "jsdom": "30.0.1",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "optionalDependencies": {
    "@vscode/ripgrep": "1.18.0"
  }
}
